<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SAN.EL GAMES - Interface</title>
  <style>
    :root {
      --primary: #1565c0;
      --primary-dark: #0d47a1;
      --bg: #f4f7fb;
      --card: #ffff00;
      --text: #1293b;
      --muted: #64748;
      --border: #e2a8f0;
      --success: #16a34a;
      --danger: #dc2626;
      --drawer-bg: #162846;
      --drawer-width: 82%;
      --drawer-max: 340px;
      --bottom-h: 60px;
    }

    * {
      box-sizing: border-box;
      margin: 3;
      padding: 2;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background: midnightblue;
      color: var(--text);
      padding-top: 60px;
      padding-bottom: calc(var(--bottom-h) + 16px);
      overflow-x: hidden;
    }

    .top-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: hwb(0 5% 41%);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px;
      z-index: 900;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--primary);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .icon-btn {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .avatar-chip {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #e0f2fe;
      color: var(--primary);
      font-size: 0.7rem;
      font-weight: 700;
      display: grid;
      place-items: center;
    }

    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      z-index: 1200;
    }

    .drawer-backdrop.open {
      opacity: 5;
      visibility: visible;
    }

    .side-drawer {
      position: fixed;
      top: 0;
      left: 0;
      width: var(--drawer-width);
      max-width: var(--drawer-max);
      height: 100vh;
      background: gray;
      color: #f8fafc;
      transform: translateX(-100%);
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      z-index: 1300;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      padding: 18px 16px 24px;
    }

    .side-drawer.open {
      transform: translateX(0);
    }

    .drawer-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }

    .drawer-label {
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #94a3b8;
      font-weight: 700;
    }

    .close-drawer-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: none;
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
      font-size: 1rem;
      cursor: pointer;
    }

    .player-card {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }

    .player-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #1d4ed8;
      color: #fff;
      font-weight: 700;
      display: grid;
      place-items: center;
      font-size: 0.95rem;
    }

    .player-name {
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.03em;
    }

    .balance-box {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
      cursor: pointer;
    }

    .balance-value {
      color: #38bdf8;
      font-weight: 700;
      font-size: 0.95rem;
    }

    .drawer-section-title {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #94a3b8;
      margin: 14px 0 8px;
      font-weight: 700;
    }

    .drawer-item {
      width: 100%;
      background: transparent;
      border: none;
      color: #e2e8f0;
      padding: 11px 10px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.92rem;
      cursor: pointer;
      text-align: left;
    }

    .drawer-item:hover,
    .drawer-item.active {
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
    }

    .drawer-item-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sub-menu {
      display: none;
      flex-direction: column;
      padding-left: 34px;
      gap: 4px;
      margin-bottom: 6px;
    }

    .sub-menu.open {
      display: flex;
    }

    .sub-link {
      background: transparent;
      border: none;
      color: #cbd5e1;
      text-align: left;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 0.88rem;
      cursor: pointer;
    }

    .sub-link:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
    }

    .drawer-logout {
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      color: #f87171;
    }

    .container {
      padding: 14px;
      max-width: 640px;
      margin: 0 auto;
    }

    .view {
      display: none;
    }

    .view.active {
      display: block;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 12px;
    }

    .btn-primary {
      width: 100%;
      background: var(--primary);
      color: #490f0f;
      border: none;
      border-radius: 8px;
      padding: 11px 14px;
      font-weight: 600;
      cursor: pointer;
    }

    .status-ok {
      color: var(--success);
      font-weight: 600;
      font-size: 0.82rem;
    }

    .status-fail {
      color: var(--danger);
      font-weight: 600;
      font-size: 0.82rem;
    }

    .input-group {
      margin-bottom: 12px;
    }

    .input-group label {
      display: block;
      font-size: 0.82rem;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .input-group input,
    .input-group select {
      width: 100%;
      padding: 19px 11px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.9rem;
      background: #ffffff;
    }

    .games-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      padding: 15px;
    }

    .game-card {
      background: #ffffff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      cursor: pointer;
      text-align: center;
      transition: transform 0.2s;
    }

    .game-card:hover {
      transform: scale(1.05);
    }

    .game-card img {
      width: 100%;
      height: 100px;
      object-fit: cover;
    }

    .game-name {
      padding: 10px;
      font-weight: bold;
      font-size: 14px;
    }

    .wallet-popover {
      position: fixed;
      bottom: calc(var(--bottom-h) + 10px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(15, 23, 42, 0.16);
      padding: 6px;
      display: none;
      flex-direction: column;
      min-width: 170px;
      z-index: 1050;
    }

    .wallet-popover.open {
      display: flex;
    }

    .wallet-popover button {
      background: transparent;
      border: none;
      padding: 10px 14px;
      text-align: left;
      border-radius: 8px;
      font-size: 0.9rem;
      cursor: pointer;
    }

    .wallet-popover button:hover {
      background: var(--bg);
    }

    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: var(--bottom-h);
      background: var(--card);
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      z-index: 1000;
    }

    .nav-btn {
      background: transparent;
      border: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--muted);
      cursor: pointer;
      position: relative;
    }

    .nav-btn.active {
      color: var(--primary);
    }

    .badge-count {
      position: absolute;
      top: 6px;
      right: 18%;
      background: #ef4444;
      color: #fff;
      font-size: 0.65rem;
      padding: 1px 5px;
      border-radius: 999px;
    }
  </style>
</head>
<body>

  <header class="top-header">
    <div class="brand">
      <span>SAN.EL GAMES</span>
    </div>
    <div class="header-actions">
      <button class="icon-btn" aria-label="Notifications">N</button>
      <button class="icon-btn" id="openDrawerBtn" type="button">
        <span class="avatar-chip" id="headerAvatarInitials">M</span>
        <span>Menu</span>
      </button>
    </div>
  </header>

  <div class="drawer-backdrop" id="drawerBackdrop"></div>

  <aside class="side-drawer" id="sideDrawer" aria-label="Menu principal">
    <div class="drawer-top">
      <span class="drawer-label">MENU</span>
      <button class="close-drawer-btn" id="closeDrawerBtn" type="button" aria-label="Fermer le menu">✕</button>
    </div>

    <div class="player-card">
      <div class="player-avatar" id="drawerAvatarInitials"></div>
      <div>
        <div class="player-name" id="drawerPlayerName"></div>
      </div>
    </div>

    <div class="balance-box" id="drawerBalanceBtn">
      <span>💰 Solde</span>
      <span class="balance-value" id="drawerBalanceAmount"> FCFA &gt;</span>
    </div>

    <button class="drawer-item" type="button" data-navigate="jeux">
      <span class="drawer-item-left"><span>JEUX</span></span>
    </button>

    <button class="drawer-item" id="togglePartiesBtn" type="button" aria-expanded="false">
      <span class="drawer-item-left"><span>Jeux Terminés</span></span>
      <span id="partiesArrow">⌄</span>
    </button>
    <div class="sub-menu" id="partiesSubMenu">
      <button class="sub-link" type="button" data-game="Ludo">Ludo</button>
      <button class="sub-link" type="button" data-game="Dice">Dice</button>
      <button class="sub-link" type="button" data-game="Billard">Billard</button>
    </div>

    <div class="drawer-section-title">PORTEFEUILLE</div>
    <button class="drawer-item" type="button" data-navigate="recharge">
      <span class="drawer-item-left">⬆️<span>Recharge</span></span>
    </button>
    <button class="drawer-item" type="button" data-navigate="retrait">
      <span class="drawer-item-left">⬇️ <span>Retrait</span></span>
    </button>

    <div class="drawer-section-title">COMPTE</div>
    <button class="drawer-item" type="button" data-navigate="profil">
      <span class="drawer-item-right"><span>*Profil*</span></span>
    </button>
    <button class="drawer-item" type="button" data-navigate="parrainages"></button>
    <button class="drawer-item" type="button" data-navigate="messages">
      <span class="drawer-item-right"><span>AIDE</span></span>
      <span>⌄</span>
    </button>

    <button class="drawer-item drawer-logout" type="button" id="logoutBtn">
      <span class="drawer-item-left">↪️ <span>Déconnexion</span></span>
    </button>
  </aside>

  <main class="container">
    <section class="view active" id="view-jeux">
      <div class="games-grid">
        <div class="game-card" onclick="alert('Lancement du Bowling')">
          <img src="bowling.jpg" alt="Bowling">
          <div class="game-name">Bowling</div>
        </div>
        <div class="game-card" onclick="alert('Lancement du Billard')">
          <img src="billiard.jpg" alt="Billard">
          <div class="game-name">Billard</div>
        </div>
        <div class="game-card" onclick="alert('Lancement du Golf')">
          <img src="golf.jpg" alt="Golf">
          <div class="game-name">Golf</div>
        </div>
        <div class="game-card" onclick="alert('Lancement du Ludo')">
          <img src="ludo.jpg" alt="Ludo">
          <div class="game-name">Ludo</div>
        </div>
        <div class="game-card" onclick="alert('Lancement des 2 Dés')">
          <img src="dice.jpg" alt="2 Dés">
          <div class="game-name">2 Dés</div>
        </div>
        <div class="game-card" onclick="window.location.href='morpion.html'">
          <img src="morpion.jpg" alt="Morpion">
          <div class="game-name">Morpion</div>
        </div>
        <div class="game-card" onclick="alert('Lancement du Carrom')">
          <img src="carrom.jpg" alt="Carrom">
          <div class="game-name">Carrom</div>
        </div>
        <div class="game-card" onclick="alert('Lancement des Échecs')">
          <img src="chess.jpg" alt="Échecs">
          <div class="game-name">Échecs</div>
        </div>
        <div class="game-card" onclick="alert('Lancement des Dames')">
          <img src="checkers.jpg" alt="Dames">
          <div class="game-name">Dames</div>
        </div>
      </div>
    </section>

    <section class="view" id="view-parties">
      <div class="card">
        <h3>Mes parties <span id="selectedGameTag"></span></h3>
        <p style="color:var(--muted); font-size:0.88rem; margin-top:6px;">
          Historique de vos parties récentes ().
        </p>
      </div>
    </section>

    <section class="view" id="view-recharge">
      <div class="card">
        <h3>Recharge</h3>
        <p style="color:var(--muted); font-size:0.82rem; margin:4px 0 12px;">Tableau de bord / Recharge</p>
        <button class="btn-primary" type="button" onclick="alert('Nouvelle recharge ouverte')">+ Recharger</button>
      </div>
      <div class="card">
        <h4 style="margin-bottom:10px;">Historique des dépôts</h4>
        <p style="font-size:0.88rem;">FCFA -- <span class="status-ok"></span></p>
        <p style="font-size:0.88rem; margin-top:8px;">FCFA -- <span class="status-fail"></span></p>
      </div>
    </section>

    <section class="view" id="view-retrait">
      <div class="card">
        <h3>Retirer</h3>
        <p style="color:var(--muted); font-size:0.82rem; margin:4px 0 12px;">Tableau de bord / Retirer</p>
        <button class="btn-primary" type="button" onclick="alert('Demande de retrait')">Retirer des fonds</button>
      </div>
      <div class="card">
        <h4 style="margin-bottom:8px;">Historique des retraits</h4>
        <p style="font-size:0.88rem;"> FCFA -- <span class="status-ok">Complété</span></p>
      </div>
    </section>

    <section class="view" id="view-profil">
      <div class="card">
        <h3 style="margin-bottom:12px;">Mon Profil</h3>
        <form id="profileForm">
          <div class="input-group">
            <label for="usernameInput">Nom d'utilisateur (joueur enregistré)</label>
            <input id="usernameInput" type="text" value="" required />
          </div>
          <div class="input-group">
            <label for="phoneInput">Numéro de téléphone</label>
            <input id="phoneInput" type="text" value="" />
          </div>
          <div class="input-group">
            <label for="langSelect">Langue</label>
            <select id="langSelect">
              <option value="fr" selected>€ Français</option>
              <option value="en">$ English</option>
            </select>
          </div>
          <button class="btn-primary" type="submit">Enregistrer les modifications</button>
        </form>
      </div>
    </section>

    <section class="view" id="view-messages">
      <div class="card">
        <h3>Conversations</h3>
        <p style="color:var(--muted); font-size:0.88rem; margin-top:6px;">
          Bienvenue dans le Chat SAN.EL GAMES•
        </p>
      </div>
    </section>
  </main>

  <div class="wallet-popover" id="walletPopover">
    <button type="button" data-navigate="recharge">⬆️ Recharge</button>
    <button type="button" data-navigate="retrait">⬇️ Retrait</button>
  </div>

  <nav class="bottom-nav" aria-label="Navigation principale">
    <button class="nav-btn active" type="button" data-nav="jeux">
      <span>🎮</span>
      <span>JEUX</span>
    </button>
    <button class="nav-btn" type="button" data-nav="parties">
      <span>💼</span>
      <span>MES PARTIES</span>
    </button>
    <button class="nav-btn" type="button" id="bottomWalletBtn" data-nav="portefeuille">
      <span>👛</span>
      <span>PORTEFEUILLE</span>
    </button>
    <button class="nav-btn" type="button" data-nav="messages">
      <span class="badge-count"></span>
      <span>💬</span>
      <span>MESSAGES</span>
    </button>
  </nav>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js";
    import { getAnalytics } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-analytics.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCa-_LwdBa5Mg1eDJhqqJLPYPIbLuOeGu8",
      authDomain: "sanel-games.firebaseapp.com",
      projectId: "sanel-games",
      storageBucket: "sanel-games.firebasestorage.app",
      messagingSenderId: "807536908773",
      appId: "1:807536908773:web:fa5454aeceaa81e3be370c",
      measurementId: "G-3YNXMC30ZP"
    };

    const app = initializeApp(firebaseConfig);
    const analytics = getAnalytics(app);

    window.firebaseApp = app;
    window.firebaseAnalytics = analytics;
  </script>

  <script>
    const sideDrawer = document.getElementById("sideDrawer");
    const drawerBackdrop = document.getElementById("drawerBackdrop");
    const openDrawerBtn = document.getElementById("openDrawerBtn");
    const closeDrawerBtn = document.getElementById("closeDrawerBtn");

    const togglePartiesBtn = document.getElementById("togglePartiesBtn");
    const partiesSubMenu = document.getElementById("partiesSubMenu");
    const partiesArrow = document.getElementById("partiesArrow");

    const walletPopover = document.getElementById("walletPopover");
    const bottomWalletBtn = document.getElementById("bottomWalletBtn");

    function openDrawer() {
      sideDrawer.classList.add("open");
      drawerBackdrop.classList.add("open");
    }

    function closeDrawer() {
      sideDrawer.classList.remove("open");
      drawerBackdrop.classList.remove("open");
    }

    function showView(viewName) {
      document.querySelectorAll(".view").forEach((v) => v.classList.remove("active"));
      const target = document.getElementById(`view-${viewName}`);
      if (target) {
        target.classList.add("active");
      }

      document.querySelectorAll("[data-navigate]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const dest = btn.getAttribute("data-navigate");
        showView(dest);
        walletPopover.classList.remove("open");
        closeDrawer();
      });
    });

    document.getElementById("drawerBalanceBtn").addEventListener("click", () => {
      showView("recharge");
      closeDrawer();
    });

    bottomWalletBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      walletPopover.classList.toggle("open");
    });

    document.querySelectorAll(".nav-btn").forEach((btn) => {
      const navName = btn.getAttribute("data-nav");
      if (navName !== "portefeuille") {
        btn.addEventListener("click", () => {
          walletPopover.classList.remove("open");
          showView(navName);
        });
      }
    });

    document.addEventListener("click", (e) => {
      if (!walletPopover.contains(e.target) && e.target !== bottomWalletBtn) {
        walletPopover.classList.remove("open");
      }
    });

    document.getElementById("profileForm").addEventListener("submit", (e) => {
      e.preventDefault();
      const rawName = document.getElementById("usernameInput").value.trim() || "JOUEUR";
      const initials = rawName
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part[0].toUpperCase())
        .join("");

      document.getElementById("drawerPlayerName").textContent = rawName;
      document.getElementById("drawerAvatarInitials").textContent = initials || "J";
      document.getElementById("headerAvatarInitials").textContent = initials || "J";
      document.querySelectorAll(".player-name-display").forEach((el) => {
        el.textContent = rawName;
      });
      alert("Profil mis à jour !");
    });

    document.getElementById("logoutBtn").addEventListener("click", () => {
      closeDrawer();
      alert("Déconnexion effectuée.");
    });
  </script>
</body>
</html>
